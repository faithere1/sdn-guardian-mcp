# Backend mode: "mock" (SQLite emulator, default, works offline/Colab) or "live" (Cisco IOS-XE)
SDN_GUARDIAN_MODE=mock

# SQLite state file (Source of Truth, flow table, telemetry, commits)
SDN_GUARDIAN_DB=./sdn_guardian.db

# Dead-Man's Switch default timeout in seconds
SDN_GUARDIAN_COMMIT_TIMEOUT=30

# Protected management subnets / controller IP (never blockable), comma-separated
SDN_GUARDIAN_PROTECTED_SUBNETS=10.10.10.0/24
SDN_GUARDIAN_CONTROLLER_IP=10.10.10.10

# Live mode: Cisco IOS-XE (DevNet Always-On Sandbox or own device)
IOSXE_HOST=
IOSXE_USERNAME=
IOSXE_PASSWORD=
IOSXE_RESTCONF_PORT=443
IOSXE_NETCONF_PORT=830
IOSXE_VERIFY_TLS=false
# Guardian-owned extended ACL used as the flow table (seq = 10000 - priority)
IOSXE_ACL_NAME=SDN-GUARDIAN

# LLM (Colab): Hugging Face token if the model requires auth; backend auto|bf16|4bit|vllm|replay
HF_TOKEN=
SDN_GUARDIAN_LLM_BACKEND=auto
